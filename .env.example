# Copy to .env and adjust as needed. Never commit real credentials.

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bug2pr

BENCHMARK_PATH=backend/benchmark/issues

DOCKER_CPU_LIMIT=2.0
DOCKER_MEMORY_LIMIT=2g
DOCKER_TIMEOUT=600

REPOSITORY_ALLOWLIST=backend/benchmark/allowlist.json

# Phase 2 localization
LOCALIZATION_CACHE_DIR=backend/cache
LOCALIZATION_EMBEDDING_MODEL=jina

# Phase 4 git & draft PR delivery.
# No GitHub token belongs here or anywhere else in this project: pushing and
# PR creation use the gh CLI's own credential store (`gh auth login`).
# While GITHUB_ENABLED is false the agent still branches, commits and
# verifies locally, and refuses to push anything.
GITHUB_ENABLED=false
GITHUB_TARGET_REPO=
GITHUB_PR_BASE_BRANCH=main
GITHUB_BRANCH_PREFIX=bug2pr

# Phase 3 fix generation. Default is the local Ollama model; for a hosted
# model (Gemini, Groq, OpenRouter...) set the backend to openai_compatible.
GENERATION_BACKEND=ollama
GENERATION_MODEL=qwen2.5-coder:7b
# GENERATION_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# GENERATION_API_KEY=
